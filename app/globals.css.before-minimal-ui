@import "tailwindcss";
:root {
  --ink: #202737;
  --muted: #727b8c;
  --line: #e6e9ed;
  --bg: #f6f7f9;
  --lime: #c6f68c;
  --purple: #6952ba;
  font-family: Arial, Helvetica, sans-serif;
  color: var(--ink);
  background: var(--bg);
  font-size: 16px;
}
* {
  box-sizing: border-box;
}
body {
  margin: 0;
}
button,
input,
select,
textarea {
  font: inherit;
}
button,
a,
input,
select,
textarea {
  outline-offset: 4px;
}
button {
  cursor: pointer;
  border: 1px solid var(--line);
  background: white;
  border-radius: 7px;
  padding: 9px 13px;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--ink);
  transition: background 0.15s;
}
button:hover {
  background: #eef0f4;
}
button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}
a {
  color: var(--purple);
  text-decoration: none;
}
p {
  font-size: 0.9375rem;
  line-height: 1.65;
  color: var(--muted);
  margin: 8px 0 20px;
}
h1,
h2,
h3 {
  color: var(--ink);
  margin: 0;
  line-height: 1.2;
}
h1 {
  font-size: 2.15rem;
  letter-spacing: -1.2px;
  font-weight: 650;
}
h2 {
  font-size: 1.18rem;
  font-weight: 650;
}
h3 {
  font-size: 1rem;
  font-weight: 650;
}
small,
.small {
  font-size: 0.8125rem;
}
small {
  display: block;
  color: var(--muted);
  line-height: 1.5;
  margin-top: 4px;
}
.muted {
  color: var(--muted);
}
b,
strong {
  font-weight: 600;
}
.primary {
  background: var(--ink);
  border-color: var(--ink);
  color: white;
}
.primary:hover {
  background: #354059;
}
.primary:disabled {
  background: #727b8c;
}
.dark-button {
  background: #24352d;
  color: white;
  border-color: #24352d;
}
.danger {
  background: #a43142;
  color: white;
}
.text-danger,
.error {
  color: #a33446;
}
.success {
  color: #376a36;
}
.text-link {
  color: var(--ink);
  font-weight: 650;
  border: 0;
  background: transparent;
  padding: 0;
  text-align: left;
}
.text-link:hover {
  color: var(--purple);
  background: none;
}
input:not([type="checkbox"]),
select,
textarea {
  border: 1px solid #dfe3e9;
  border-radius: 7px;
  padding: 10px 12px;
  background: white;
  color: var(--ink);
  min-width: 0;
  font-size: 0.875rem;
}
input[type="checkbox"] {
  accent-color: #6952ba;
  width: 16px;
  height: 16px;
}
textarea {
  width: 100%;
  resize: vertical;
  min-height: 85px;
}
label {
  font-size: 0.875rem;
  display: flex;
  flex-direction: column;
  gap: 7px;
  font-weight: 500;
}
label.check {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 9px;
  font-weight: 400;
}
fieldset {
  border: 1px solid var(--line);
  border-radius: 8px;
  margin: 20px 0;
  padding: 15px;
}
legend {
  font-size: 0.875rem;
  font-weight: 600;
}
.app-shell {
  display: flex;
  min-height: 100vh;
}
.sidebar {
  width: 240px;
  flex-shrink: 0;
  position: fixed;
  top: 0;
  bottom: 0;
  background: #fff;
  border-right: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  padding: 32px 18px 0;
  z-index: 20;
}
.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--ink);
  font-size: 1.6rem;
  font-weight: 750;
  letter-spacing: -1px;
  padding: 0 8px;
  margin-bottom: 52px;
}
.brand small {
  font-size: 0.5625rem;
  letter-spacing: 1.25px;
  font-weight: 600;
  margin-top: 5px;
}
.brand-light {
  font-weight: 400;
}
.brand-mark {
  background: var(--ink);
  color: var(--lime);
  width: 40px;
  height: 43px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  font-size: 2rem;
  line-height: 1;
  flex-shrink: 0;
}
.nav-label {
  color: #9ba2ae;
  font-size: 0.6875rem;
  letter-spacing: 1.4px;
  font-weight: 600;
  margin: 0 14px 12px;
}
.sidebar nav {
  display: flex;
  flex-direction: column;
  gap: 5px;
}
.sidebar nav button {
  display: flex;
  align-items: center;
  gap: 13px;
  background: transparent;
  border: 0;
  color: #727987;
  text-align: left;
  padding: 13px 15px;
  font-weight: 500;
  font-size: 0.9375rem;
}
.sidebar nav button > span {
  font-size: 1.2rem;
  width: 22px;
  text-align: center;
}
.sidebar nav button.active {
  background: #eef2e9;
  color: #26342c;
  font-weight: 650;
}
.sidebar nav button small {
  margin: 0 0 0 auto;
  background: #dde7d6;
  color: #536348;
  border-radius: 5px;
  padding: 0 5px;
}
.sidebar nav .nav-break {
  margin-top: 24px;
}
.sidebar-bottom {
  margin-top: auto;
  padding-top: 24px;
}
.private-note {
  display: flex;
  gap: 10px;
  padding: 17px 11px;
  border: 1px solid var(--line);
  border-radius: 8px;
  font-size: 0.6875rem;
}
.private-note p {
  font-size: 0.6875rem;
  margin: 4px 0 0;
}
.private-note > span {
  font-size: 1.3rem;
}
.user {
  display: flex;
  gap: 9px;
  align-items: center;
  border-top: 1px solid var(--line);
  margin-top: 25px;
  padding: 22px 0;
  font-size: 0.8125rem;
}
.user form {
  margin-left: auto;
}
.user form button {
  border: 0;
}
.user small {
  text-transform: capitalize;
  margin: 1px 0;
}
.avatar {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: #eeeaf7;
  color: #78658e;
  font-size: 0.8125rem;
  font-weight: 650;
  flex-shrink: 0;
}
.main {
  margin-left: 240px;
  flex: 1;
  min-width: 0;
}
.topbar {
  height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 38px;
  border-bottom: 1px solid var(--line);
  background: #fff;
  font-size: 0.8125rem;
}
.topbar > div {
  display: flex;
  align-items: center;
}
.crumb {
  margin: 0 14px;
  color: #b6bdc8;
}
.workspace-badge {
  border: 1px solid var(--line);
  padding: 7px 11px;
  border-radius: 20px;
  font-size: 0.75rem;
  color: #7b8490;
}
.workspace-badge span {
  margin-left: 14px;
}
.content {
  max-width: 1600px;
  margin: auto;
  padding: 38px;
}
.page-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 25px;
  margin-bottom: 28px;
}
.page-heading > div > p:last-child {
  margin: 12px 0 0;
}
.eyebrow {
  font-size: 0.6875rem !important;
  letter-spacing: 1.8px;
  font-weight: 650;
  margin: 0 0 12px;
  color: #9199a5;
}
.stat-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
  margin-bottom: 26px;
}
.stat {
  padding: 23px 23px 21px;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 10px;
}
.stat > div {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
.stat span {
  font-size: 0.8125rem;
  color: #778090;
}
.stat strong {
  display: block;
  font-size: 2.1rem;
  letter-spacing: -1px;
  margin: 16px 0 8px;
}
.stat small {
  font-size: 0.75rem;
}
.stat .stat-icon {
  font-size: 1.1rem;
  color: #858d9b;
}
.getting-started {
  display: flex;
  position: relative;
  overflow: hidden;
  align-items: center;
  gap: 25px;
  background: #eaf3de;
  border: 1px solid #dce8cf;
  border-radius: 11px;
  padding: 36px;
  margin-bottom: 28px;
  min-height: 265px;
}
.hero-glyph {
  display: none;
}
.getting-started h2 {
  font-size: 1.8rem;
  letter-spacing: -0.7px;
  margin-top: 14px;
}
.getting-started p {
  color: #687661;
  font-size: 0.875rem;
}
.getting-started > div:not(.card-art) {
  position: relative;
  z-index: 1;
}
.badge {
  display: inline-block;
  white-space: nowrap;
  border-radius: 5px;
  padding: 4px 8px;
  background: #f0f2f5;
  color: #717b8a;
  font-size: 0.6875rem;
  line-height: 1.3;
  font-weight: 550;
}
.badge.green {
  background: #eaf4e8;
  color: #537346;
}
.badge.amber {
  background: #fbf0dc;
  color: #976e2b;
}
.badge.violet {
  background: #eeeafa;
  color: #7c60ab;
}
.badge.red {
  background: #fbe8ec;
  color: #a33446;
}
.badge.dark {
  background: #ddeacd;
  color: #4d6240;
  font-size: 0.625rem;
  letter-spacing: 1px;
}
.card-art {
  position: absolute;
  right: 35px;
  top: 25px;
  width: 265px;
  height: 240px;
  opacity: 0.9;
}
.art-card {
  position: absolute;
  width: 135px;
  height: 183px;
  border: 5px solid #fff;
  border-radius: 13px;
  box-shadow: 0 14px 20px #5769441a;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  font-size: 5rem;
  overflow: hidden;
}
.art-card small {
  font-size: 0.5rem;
  letter-spacing: 1.5px;
  color: inherit;
}
.art-card.one {
  left: 0;
  top: 3px;
  transform: rotate(-17deg);
  background: #c2cfae;
  color: #f3f8e8;
}
.art-card.two {
  right: 12px;
  top: 26px;
  transform: rotate(13deg);
  background: #2d4236;
  color: #c5e8a9;
}
.dashboard-grid {
  display: grid;
  grid-template-columns: 1.65fr 1fr;
  gap: 24px;
  margin-bottom: 24px;
}
.panel {
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 10px;
  overflow: hidden;
}
.pad {
  padding: 24px;
}
.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}
.section-title p {
  font-size: 0.8125rem;
  margin: 7px 0 0;
}
.section-title button {
  font-size: 0.75rem;
}
.empty {
  text-align: center;
  padding: 46px 25px;
}
.empty-icon {
  font-size: 2rem;
  color: #aeb5a3;
  display: block;
  margin-bottom: 14px;
}
.empty p {
  font-size: 0.875rem;
  margin: 10px 0;
}
.coverage-list {
  padding: 0 24px 15px;
}
.coverage-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 18px 0;
  background: transparent;
  border: 0;
  border-bottom: 1px solid #eff1f4;
  border-radius: 0;
  text-align: left;
  font-weight: 400;
}
.coverage-item:last-child {
  border: 0;
}
.identity {
  display: flex;
  align-items: center;
  gap: 11px;
  min-width: 130px;
}
.identity b {
  font-size: 0.875rem;
}
.identity small {
  font-size: 0.75rem;
}
.group-avatar {
  background: #eff0f5;
  color: #747887;
}
.coverage-value {
  text-align: right;
  min-width: 88px;
  margin-left: 15px;
}
.coverage-value b {
  font-size: 0.8125rem;
}
.progress {
  height: 5px;
  background: #eef0f4;
  border-radius: 6px;
  overflow: hidden;
  margin-top: 9px;
}
.progress > span {
  height: 100%;
  background: #a6ca81;
  display: block;
  border-radius: 6px;
}
.pipeline {
  padding: 0 24px 16px;
}
.pipeline > button {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  border: 0;
  background: none;
  text-align: left;
  padding: 13px 0;
  font-weight: 500;
}
.pipeline > button > strong {
  margin-left: auto;
  font-size: 1.05rem;
}
.pipeline small {
  font-size: 0.6875rem;
}
.pipeline-icon {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border-radius: 8px;
  background: #f0eef7;
  color: #8b7caa;
}
.p2,
.p3 {
  background: #edf3e6;
  color: #809a63;
}
.panel-foot {
  border-top: 1px solid var(--line);
  padding: 15px 24px;
  color: #8d94a0;
  font-size: 0.75rem;
}
.notice {
  background: #f0f2f7;
  border: 1px solid #e2e5ee;
  border-radius: 9px;
  padding: 20px 24px;
  font-size: 0.875rem;
  margin-bottom: 20px;
}
.notice p {
  margin: 5px 0 0;
  font-size: 0.8125rem;
}
.app-footer {
  display: flex;
  justify-content: space-between;
  padding: 15px 38px 30px;
  font-size: 0.6875rem;
  color: #9ca3af;
}
.app-footer > span:first-child {
  font-weight: 600;
  letter-spacing: 1.5px;
}
.table-toolbar,
.toolbar {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}
.table-toolbar {
  padding: 20px 24px;
  border-bottom: 1px solid var(--line);
}
.table-toolbar h2 {
  margin-right: auto;
}
.search {
  flex: 1;
  min-width: 220px !important;
  max-width: 520px;
}
.table-scroll {
  overflow-x: auto;
}
table {
  border-collapse: collapse;
  width: 100%;
  font-size: 0.8125rem;
  text-align: left;
}
th {
  padding: 13px 18px;
  background: #fafbfc;
  color: #7d8592;
  font-size: 0.75rem;
  font-weight: 500;
  white-space: nowrap;
  border-bottom: 1px solid var(--line);
}
th button {
  border: 0;
  padding: 0;
  font: inherit;
  background: transparent;
  white-space: nowrap;
}
td {
  padding: 17px 18px;
  border-bottom: 1px solid #eff1f4;
  vertical-align: middle;
}
tr:last-child td {
  border-bottom: 0;
}
tbody tr:hover {
  background: #fcfcfe;
}
td small {
  font-size: 0.6875rem;
  max-width: 310px;
}
.notes {
  max-width: 160px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.row-actions {
  display: flex;
  gap: 8px;
}
.row-actions button {
  padding: 5px 7px;
  font-size: 0.75rem;
}
.pagination {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  border-top: 1px solid var(--line);
  font-size: 0.75rem;
  color: var(--muted);
}
.pagination > div {
  display: flex;
  align-items: center;
  gap: 15px;
}
.pagination button {
  font-size: 0.75rem;
}
.filters {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
  padding: 20px 24px;
  border-bottom: 1px solid var(--line);
  background: #fafbfc;
}
.filter-label > span {
  font-size: 0.75rem;
  color: var(--muted);
}
.stack {
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.stack > .stat-grid,
.stack > .dashboard-grid {
  margin-bottom: 0;
}
.detail-toolbar {
  display: flex;
  align-items: center;
  gap: 15px;
  flex-wrap: wrap;
  font-size: 0.875rem;
}
.back {
  border: 0;
  padding: 0;
  margin-bottom: 20px;
  background: transparent;
  color: var(--purple);
}
.rarity-bars {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
  margin-top: 20px;
}
.rarity-bars > div {
  display: flex;
  align-items: center;
  gap: 10px;
}
.rarity-bars .progress {
  flex: 1;
  margin: 0;
}
.history-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  width: 100%;
  border: 0;
  border-bottom: 1px solid var(--line);
  padding: 16px 0;
  font-size: 0.875rem;
  border-radius: 0;
}
.history-row > span {
  color: var(--muted);
  font-size: 0.8125rem;
  text-align: right;
}
.export-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
}
.export-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-height: 260px;
}
.export-card button {
  margin-top: auto;
}
.export-number {
  font-size: 0.75rem;
  color: #9b8aae;
  margin-bottom: 25px;
}
.export-card p {
  font-size: 0.875rem;
}
.steps {
  display: flex;
  align-items: center;
  gap: 18px;
  max-width: 750px;
  color: #abb2bd;
  font-size: 0.875rem;
}
.steps i {
  flex: 1;
  height: 1px;
  background: var(--line);
}
.steps b {
  margin-left: 9px;
  font-weight: 500;
}
.steps .active {
  color: #5f754e;
}
.segmented {
  display: flex;
  gap: 4px;
  background: #e9edf1;
  border-radius: 9px;
  padding: 4px;
  width: fit-content;
}
.segmented button {
  background: none;
  border: 0;
  font-weight: 500;
}
.segmented button.active {
  background: #fff;
  box-shadow: 0 2px 4px #00000009;
}
.upload {
  text-align: center;
  padding: 44px 25px;
}
.upload h2 {
  font-size: 1.4rem;
}
.upload > p {
  max-width: 520px;
  margin: 14px auto 20px;
}
.upload-icon {
  display: grid;
  place-items: center;
  margin: 0 auto 18px;
  width: 55px;
  height: 55px;
  background: #f0f4e9;
  border-radius: 15px;
  color: #788d64;
  font-size: 1.6rem;
}
.file-button {
  display: inline-flex;
  border-radius: 7px;
  padding: 12px 18px;
  cursor: pointer;
}
.file-button input {
  position: absolute;
  opacity: 0;
  width: 1px;
  height: 1px;
}
.file-button:focus-within {
  outline: 2px solid var(--purple);
  outline-offset: 3px;
}
.sheet-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-top: 20px;
}
.sheet-option {
  flex-direction: row;
  align-items: center;
  border: 1px solid var(--line);
  padding: 13px;
  border-radius: 8px;
}
.sheet-option small {
  font-size: 0.75rem;
}
.compact {
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 0;
}
.compact .stat {
  padding: 18px;
}
.compact .stat strong {
  font-size: 1.5rem;
}
.compact .stat span {
  font-size: 0.75rem;
}
.toolbar {
  justify-content: space-between;
  margin-top: 18px;
}
.toolbar p {
  margin: 0;
}
.modal {
  position: fixed;
  inset: 0;
  margin: auto;
  width: min(850px, calc(100vw - 32px));
  max-height: 90vh;
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 28px;
  box-shadow: 0 25px 120px #161d3238;
  background: #fff;
  color: var(--ink);
  overflow-y: auto;
}
.modal::backdrop {
  background: #111a3280;
  backdrop-filter: blur(3px);
}
.modal > header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}
.icon-button {
  border: 0;
  font-size: 1.5rem;
  padding: 0 6px;
}
.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 25px;
  padding-top: 20px;
  border-top: 1px solid var(--line);
}
.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}
.modal form > label {
  margin: 18px 0;
}
.member-picker {
  max-height: 180px;
  overflow: auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 9px;
  margin-top: 15px;
}
.member-picker small {
  margin: 0;
}
.toast {
  position: fixed;
  right: 30px;
  top: 90px;
  background: #263b2b;
  color: white;
  border-radius: 8px;
  padding: 14px 20px;
  font-size: 0.875rem;
  box-shadow: 0 5px 20px #0002;
  z-index: 50;
}
.mobile-menu {
  display: none;
}
.login {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1.08fr 1fr;
  background: white;
}
.login-art {
  background: #24392f;
  color: #eff5e7;
  padding: 60px 12%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
  overflow: hidden;
}
.login-art .brand-mark {
  background: #c6f68c;
  color: #24392f;
  margin-bottom: 65px;
}
.login-art .eyebrow {
  color: #b3c2a5;
}
.login-art h1 {
  color: #f4f7ee;
  font-size: clamp(2.5rem, 4.6vw, 5.8rem);
  letter-spacing: -3px;
  line-height: 1.08;
}
.login-art h1 em {
  font-family: Georgia, serif;
  font-weight: 400;
  color: #c6f68c;
}
.login-art p:not(.eyebrow) {
  color: #b3c1ad;
  margin-top: 25px;
}
.login-caption {
  font-size: 0.625rem;
  letter-spacing: 2px;
  color: #82977c;
  margin-top: 65px;
}
.login-form {
  align-self: center;
  width: min(420px, 80%);
  justify-self: center;
  padding: 50px 0;
}
.login-form h2 {
  font-size: 2rem;
  letter-spacing: -1px;
}
.login-form form {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin: 32px 0;
}
.login-form form button {
  padding: 13px;
}
.login-form > .small {
  margin-top: 35px;
}
.error-page {
  max-width: 700px;
  padding: 60px;
  margin: auto;
}
.error-page h1 {
  margin-bottom: 20px;
}
@media (min-width: 1600px) {
  .card-art {
    right: 90px;
  }
  .getting-started {
    padding-left: 42px;
  }
  .getting-started h2 {
    font-size: 2rem;
  }
}
@media (max-width: 1250px) {
  .sidebar {
    width: 210px;
    padding-left: 12px;
    padding-right: 12px;
  }
  .main {
    margin-left: 210px;
  }
  .content {
    padding: 28px;
  }
  .topbar {
    padding: 0 28px;
  }
  .stat {
    padding: 18px;
  }
  .stat small {
    font-size: 0.6875rem;
  }
  .card-art {
    right: 0;
    opacity: 0.45;
  }
  .dashboard-grid {
    grid-template-columns: 1.3fr 1fr;
  }
  .compact {
    grid-template-columns: repeat(3, 1fr);
  }
  .filters {
    grid-template-columns: repeat(3, 1fr);
  }
  .export-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 1000px) {
  .sidebar {
    width: 190px;
  }
  .brand {
    font-size: 1.3rem;
    padding: 0;
  }
  .brand small {
    font-size: 0.5rem;
  }
  .main {
    margin-left: 190px;
  }
  .stat-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .dashboard-grid {
    grid-template-columns: 1fr;
  }
  .page-heading {
    align-items: flex-start;
    flex-direction: column;
  }
  .card-art {
    right: 10px;
    width: 205px;
    opacity: 0.35;
  }
  .sheet-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .rarity-bars {
    grid-template-columns: repeat(2, 1fr);
  }
  .compact {
    grid-template-columns: repeat(3, 1fr);
  }
}
@media (max-width: 700px) {
  .sidebar {
    display: none;
  }
  .sidebar.open {
    display: flex;
    width: 240px;
    top: 65px;
    box-shadow: 20px 0 50px #0002;
  }
  .main {
    margin: 0;
  }
  .topbar {
    height: 65px;
    padding: 0 20px;
  }
  .workspace-badge {
    display: none;
  }
  .mobile-menu {
    display: block;
    border: 0;
    margin-right: 10px;
    padding: 2px;
  }
  .content {
    padding: 25px 18px;
  }
  .page-heading {
    gap: 20px;
  }
  h1 {
    font-size: 1.85rem;
  }
  .stat-grid {
    gap: 12px;
  }
  .stat {
    padding: 17px;
  }
  .stat strong {
    font-size: 1.8rem;
  }
  .getting-started {
    padding: 25px;
    min-height: 290px;
  }
  .card-art {
    display: none;
  }
  .getting-started h2 {
    font-size: 1.5rem;
  }
  .section-title {
    align-items: flex-start;
  }
  .pad {
    padding: 20px;
  }
  .table-toolbar {
    padding: 16px;
  }
  .filters {
    grid-template-columns: repeat(2, 1fr);
  }
  .table-toolbar .search {
    max-width: none;
    flex-basis: 100%;
  }
  .pagination {
    align-items: flex-start;
    gap: 15px;
    flex-direction: column;
  }
  .export-grid {
    grid-template-columns: 1fr;
  }
  .form-grid {
    grid-template-columns: 1fr;
  }
  .modal {
    padding: 22px;
  }
  .member-picker {
    grid-template-columns: 1fr;
  }
  .steps {
    gap: 8px;
    font-size: 0.75rem;
  }
  .steps b {
    margin-left: 3px;
  }
  .sheet-grid {
    grid-template-columns: 1fr;
  }
  .compact {
    grid-template-columns: repeat(2, 1fr);
  }
  .app-footer {
    padding: 15px 20px;
  }
  .login {
    grid-template-columns: 1fr;
  }
  .login-art {
    padding: 40px;
    min-height: 320px;
  }
  .login-art .brand-mark {
    margin-bottom: 25px;
  }
  .login-art h1 {
    font-size: 2.7rem;
    letter-spacing: -1.5px;
  }
  .login-caption {
    display: none;
  }
  .login-art p:not(.eyebrow) {
    display: none;
  }
  .login-form {
    padding: 45px 0;
  }
  .login-art h1 br:nth-child(2) {
    display: none;
  }
  .login-art h1 em {
    margin-left: 5px;
  }
}
